generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(cuid())
  fullName              String
  email                 String         @unique
  phoneNumber           String         @unique
  password              String
  profileImage          String?
  role                  Role           @default(BUYER)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  buyerProfile          BuyerProfile?
  disputes              Dispute[]
  farmerProfile         FarmerProfile?
  notifications         Notification[]
  preferences           UserPreferences?
  reviewedVerifications Verification[] @relation("VerificationReviewer")
  wallet                Wallet?
  addresses             BuyerAddress[]
  moderatedProducts     Product[]        @relation("ProductModerator")
  sessions              Session[]
}

model FarmerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  farmName           String
  farmDescription    String?
  farmAddress        String
  state              String
  lga                String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  sellerOrders       SellerOrder[]
  verification       Verification?
}

model BuyerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String?
  state     String?
  lga       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  reviews   Review[]
}

model Verification {
  id              String        @id @default(cuid())
  farmerProfileId String        @unique
  documentType    String
  documentNumber  String?
  documentUrl     String
  reviewedById    String?
  reviewedAt      DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  farmerProfile   FarmerProfile @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  reviewedBy      User?         @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([reviewedById])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  farmerProfileId String
  categoryId      String
  name            String
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  unit            ProductUnit
  status          ProductStatus  @default(PENDING_APPROVAL)
  rejectionReason String?
  moderationNotes String?
  moderatedAt     DateTime?
  moderatedById   String?
  harvestDate     DateTime?
  moq             Int            @default(1)
  grade           String?
  condition       String?
  produceType     String?
  variety         String?
  packaging       String?
  packageSize     String?
  pricingNotes    String?
  qualityNotes    String?
  availabilityStatus String?     @default("AVAILABLE_NOW")
  availableFrom   DateTime?
  storageCondition String?
  storageNotes    String?
  farmState       String?
  farmLga         String?
  farmCommunity   String?
  isAvailable     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventory       Inventory?
  orderItems      OrderItem[]
  category        Category       @relation(fields: [categoryId], references: [id])
  farmerProfile   FarmerProfile  @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  moderatedBy     User?          @relation("ProductModerator", fields: [moderatedById], references: [id])
  images          ProductImage[]
  reviews         Review[]

  @@index([farmerProfileId])
  @@index([categoryId])
  @@index([status])
  @@index([moderatedById])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id           String   @id @default(cuid())
  productId    String   @unique
  availableQty Int
  reservedQty  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  buyerId           String
  shippingAddressId String?
  totalAmount       Decimal        @db.Decimal(10, 2)
  status            OrderStatus    @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  delivery          Delivery?
  disputes          Dispute[]
  buyer             BuyerProfile   @relation(fields: [buyerId], references: [id])
  shippingAddress   BuyerAddress?  @relation(fields: [shippingAddressId], references: [id])
  orderItems        OrderItem[]
  sellerOrders      SellerOrder[]
  payment           Payment?
  reviews           Review[]

  @@index([buyerId])
  @@index([shippingAddressId])
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  productId     String
  sellerOrderId String?
  quantity      Int
  unitPrice     Decimal      @db.Decimal(10, 2)
  subtotal      Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id])
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([sellerOrderId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Delivery {
  id                 String            @id @default(cuid())
  orderId            String            @unique
  logisticsPartnerId String?
  deliveryAddress    String
  deliveryStatus     DeliveryStatus    @default(PENDING)
  trackingNumber     String?
  estimatedDelivery  DateTime?
  deliveredAt        DateTime?
  podPhotoUrl        String?
  podSignatureUrl    String?
  podLatitude        Float?
  podLongitude       Float?
  podDriverName      String?
  podLicensePlate    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  logisticsPartner   LogisticsPartner? @relation(fields: [logisticsPartnerId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([logisticsPartnerId])
}

model LogisticsPartner {
  id          String     @id @default(cuid())
  companyName String
  contactName String?
  phoneNumber String
  email       String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deliveries  Delivery[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String       @id @default(cuid())
  buyerId   String
  productId String
  orderId   String?
  rating    Rating
  comment   String?
  createdAt DateTime     @default(now())
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])

  @@unique([buyerId, productId])
  @@index([productId])
  @@index([orderId])
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String
  userId      String
  title       String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model SellerOrder {
  id                String            @id @default(cuid())
  sellerOrderNumber String            @unique
  orderId           String
  farmerProfileId   String
  subtotal          Decimal           @db.Decimal(10, 2)
  shippingFee       Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  status            SellerOrderStatus @default(PENDING)
  trackingNumber    String?
  dispatchNotes     String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  farmerProfile     FarmerProfile     @relation(fields: [farmerProfileId], references: [id])
  orderItems        OrderItem[]

  @@index([orderId])
  @@index([farmerProfileId])
  @@index([status])
}

model BuyerAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("Home")
  recipientName String
  phoneNumber   String
  addressLine   String
  city          String
  state         String
  lga           String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId])
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  FARMER
  BUYER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductUnit {
  KG
  BAG
  TON
  CRATE
  PIECE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  WALLET
}

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  DELIVERY
}

enum Rating {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Wallet {
  id                String              @id @default(cuid())
  userId            String              @unique
  balance           Decimal             @default(0.00) @db.Decimal(10, 2)
  escrow            Decimal             @default(0.00) @db.Decimal(10, 2)
  pendingWithdrawal Decimal             @default(0.00) @db.Decimal(10, 2)
  frozen            Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      WalletTransaction[]
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  bankCode      String
  accountNumber String
  accountName   String
  isVerified    Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  reference   String          @unique
  description String?
  status      TxStatus        @default(SUCCESS)
  createdAt   DateTime        @default(now())
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Decimal   @db.Decimal(5, 2)
  minSpend    Decimal   @default(0.00) @db.Decimal(10, 2)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_LOCK
  ESCROW_RELEASE
  REFUND
}

enum TxStatus {
  REQUESTED
  VALIDATED
  SUBMITTED_TO_FLUTTERWAVE
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
  PENDING
}

enum AuditCategory {
  AUTH
  USER
  ORDER
  PAYMENT
  ESCROW
  DELIVERY
  KYC
  DISPUTE
  SYSTEM
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum OutboxChannel {
  EMAIL
  SMS
  PUSH
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model AuditEvent {
  id           String        @id @default(cuid())
  category     AuditCategory @default(SYSTEM)
  severity     AuditSeverity @default(INFO)
  action       String
  actorId      String?
  actorEmail   String?
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime      @default(now())

  @@index([category])
  @@index([actorId])
  @@index([resourceId])
  @@index([createdAt])
}

model NotificationOutbox {
  id          String        @id @default(cuid())
  channel     OutboxChannel
  recipient   String
  subject     String?
  payload     Json
  status      OutboxStatus  @default(PENDING)
  attempts    Int           @default(0)
  maxAttempts Int           @default(3)
  availableAt DateTime      @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, availableAt])
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  countryCode      String   @default("NG")
  regionCode       String   @default("LA")
  currencyCode     String   @default("NGN")
  timezone         String   @default("Africa/Lagos")
  locale           String   @default("en-NG")
  isCustomCurrency Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthRealm {
  ADMIN
  FARMER
  BUYER
}

model Session {
  id           String     @id @default(cuid())
  vaultId      String
  userId       String
  realm        AuthRealm
  tokenHash    String     @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vaultId, realm])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

